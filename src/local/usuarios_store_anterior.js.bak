// CRUD de usuarios en modo local (Módulo 1 · Gestión de Usuarios).
// Los usuarios se guardan en localStorage. Incluye las restricciones pedidas
// para el rol administrador:
//   - Administra cuentas (crear, listar, editar, activar/desactivar) y niveles
//     de seguridad (rol) de cada usuario.
//   - NO puede ELIMINAR físicamente registros (solo desactivar = borrado lógico).
//   - NO puede solicitar/gestionar credenciales de servidor.
//   - No puede desactivarse a sí mismo ni quitarse su propio rol de admin
//     (para no dejar el sistema sin administrador).
const CLAVE = "sipro_usuarios";

// Usuarios demo iniciales (se siembran la primera vez)
const SEMILLA = [
  { id: "u-admin", email: "admin@demo.sipro.com", password: "demo1234", nombre: "Administradora Demo", rol: "administrador", activo: true, creado_en: "2025-01-01T00:00:00Z" },
  { id: "u-analista", email: "analista@demo.sipro.com", password: "demo1234", nombre: "Analista Demo", rol: "analista", activo: true, creado_en: "2025-01-01T00:00:00Z" },
  { id: "u-ugr", email: "ugr@demo.sipro.com", password: "demo1234", nombre: "UGR Demo", rol: "ugr", activo: true, creado_en: "2025-01-01T00:00:00Z" },
  { id: "u-brigada", email: "brigada@demo.sipro.com", password: "demo1234", nombre: "Brigada Demo", rol: "brigada", activo: true, creado_en: "2025-01-01T00:00:00Z" },
];

function leer() {
  try {
    const g = JSON.parse(localStorage.getItem(CLAVE));
    if (g && Array.isArray(g) && g.length) return g;
  } catch { /* vacío */ }
  localStorage.setItem(CLAVE, JSON.stringify(SEMILLA));
  return [...SEMILLA];
}

function escribir(usuarios) {
  localStorage.setItem(CLAVE, JSON.stringify(usuarios));
}

const ok = (data) => Promise.resolve({ data });
const fallo = (detail, status = 400) => Promise.reject({ response: { status, data: { detail } } });

export const usuariosLocalStore = {
  listar: () => ok(leer().map(({ password, ...u }) => u)), // no exponer contraseñas

  crear: (usuario) => {
    const usuarios = leer();
    if (usuarios.some((u) => u.email === usuario.email)) {
      return fallo("Ya existe un usuario con ese correo.");
    }
    const nuevo = {
      id: "u-" + Date.now(),
      email: usuario.email,
      password: usuario.password || "demo1234",
      nombre: usuario.nombre,
      rol: usuario.rol,
      activo: true,
      creado_en: new Date().toISOString(),
    };
    usuarios.push(nuevo);
    escribir(usuarios);
    const { password, ...sinPass } = nuevo;
    return ok(sinPass);
  },

  actualizar: (id, cambios) => {
    const usuarios = leer();
    const i = usuarios.findIndex((u) => u.id === id);
    if (i === -1) return fallo("Usuario no encontrado", 404);
    // Solo se permiten cambios de nombre, rol y estado (no credenciales de servidor)
    const permitidos = {};
    if (cambios.nombre != null) permitidos.nombre = cambios.nombre;
    if (cambios.rol != null) permitidos.rol = cambios.rol;
    if (cambios.activo != null) permitidos.activo = cambios.activo;
    usuarios[i] = { ...usuarios[i], ...permitidos };
    escribir(usuarios);
    const { password, ...sinPass } = usuarios[i];
    return ok(sinPass);
  },

  // "Eliminar" = desactivar (borrado lógico). NO se borra el registro de la base.
  desactivar: (id) => {
    const usuarios = leer();
    const i = usuarios.findIndex((u) => u.id === id);
    if (i === -1) return fallo("Usuario no encontrado", 404);
    usuarios[i].activo = false;
    escribir(usuarios);
    return ok({ mensaje: "Usuario desactivado (el registro se conserva en la base)." });
  },
};
