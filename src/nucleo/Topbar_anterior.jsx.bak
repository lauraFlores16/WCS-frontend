import ThreatRing from "./ThreatRing";
import { useTema } from "./TemaContext";
import "./estilos/AppShell.css";

export default function Topbar({ titulo }) {
  const { tema, alternar } = useTema();
  return (
    <header className="topbar">
      <div className="topbar-titulo mono">{titulo}</div>
      <div style={{ display: "flex", alignItems: "center", gap: 16 }}>
        <button className="tema-toggle" onClick={alternar}
          title={tema === "oscuro" ? "Cambiar a modo claro" : "Cambiar a modo oscuro"}
          aria-label="Cambiar tema">
          {tema === "oscuro" ? (
            // ícono sol (cambiar a claro)
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          ) : (
            // ícono luna (cambiar a oscuro)
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z" />
            </svg>
          )}
          <span className="tema-toggle-texto">{tema === "oscuro" ? "Claro" : "Oscuro"}</span>
        </button>
        <ThreatRing />
      </div>
    </header>
  );
}
